# ─────────────────────────────────────────────────────────────
# RECOMMENDED — or leave blank and paste keys at /settings in the browser
# ─────────────────────────────────────────────────────────────

# Serper.dev — Google Search API. Free tier: 2,500 queries.
# Get one at https://serper.dev  → Dashboard → API Key
SERPER_API_KEY=

# OpenRouter — unified LLM gateway (model chosen at runtime in the UI).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────

# Public URL of the deployment. Sent to OpenRouter as HTTP-Referer
# for attribution/rankings. Falls back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord defaults. Both can also be entered in the app at /settings,
# which takes priority over these values.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
